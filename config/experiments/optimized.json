{
  "name": "optimized_solar_model_comparison",
  "description": "동일 태양광 Gold·피처·시간분할에서 모델별 Validation-only Optuna를 허용하는 실전 비교",
  "seed": 42,
  "scope": {
    "energy_source": "solar",
    "feature_contract": "selected_v3_physics_aware_day_ahead",
    "split": "global_train_validation_calibration_test_with_168h_purge",
    "forecast_horizon_hours": 24
  },
  "optimizer": {
    "framework": "optuna_tpe_median_pruner",
    "objective": "validation_mae",
    "persistent_resume": true,
    "calibration_usage": "none_during_model_selection",
    "test_usage": "final_report_only"
  },
  "xgboost": {
    "enabled": true,
    "tree_method": "hist",
    "early_stopping": true,
    "max_total_trials": 30,
    "timeout_seconds": 7200
  },
  "cnn_bilstm": {
    "enabled": true,
    "sequence_length": 168,
    "lazy_windows": true,
    "early_stopping": true,
    "max_total_trials": 20,
    "timeout_seconds": 14400
  },
  "evaluation": {
    "levels": ["plant", "region", "national"],
    "metrics": ["mae", "rmse", "r2", "capacity_normalized_mae"],
    "weights": ["samples", "equal_plant"],
    "hybrid_order": "compare_and_freeze_base_models_before_dynamic_gate_training"
  }
}
