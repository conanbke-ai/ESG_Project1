{
  "model": "cnn_bilstm",
  "profile": "optimized",
  "seed": 42,
  "input_dataset": "file/standardized/model_ready_parts",
  "target_column": "generation_mwh",
  "energy_source_filter": "solar",
  "feature_columns": [
    "temperature_c",
    "precipitation_mm",
    "sunshine_hours",
    "solar_irradiance_mj_m2",
    "wind_speed_mps",
    "humidity_pct",
    "total_cloud_cover_tenths",
    "low_mid_cloud_cover_tenths",
    "hour",
    "dayofweek",
    "month",
    "hour_sin",
    "hour_cos",
    "dayofyear_sin",
    "dayofyear_cos",
    "generation_lag_24h_mwh",
    "generation_lag_168h_mwh",
    "generation_rolling_7d_mean_mwh",
    "capacity_mw",
    "tilt_deg",
    "station_latitude",
    "station_longitude",
    "station_elevation_m",
    "solar_elevation_sin",
    "clear_sky_irradiance_proxy",
    "is_daylight"
  ],
  "feature_contract": "selected_v3_physics_aware_day_ahead",
  "quality_filter_column": "quality_train_eligible",
  "missing_value_policy": "training_split_median_with_missing_indicators",
  "csv_chunk_rows": 100000,
  "memory_limit_mb": 1536,
  "numeric_dtype": "float32",
  "entity_column": "plant_id",
  "timestamp_column": "timestamp",
  "output_root": "artifacts/models/cnn_bilstm",
  "prediction_root": "artifacts/predictions/cnn_bilstm",
  "forecast_horizon_hours": 24,
  "evaluation_protocol": "rolling_origin_day_ahead_with_observation_updates",
  "validation_fraction": 0.15,
  "calibration_fraction": 0.10,
  "test_fraction": 0.15,
  "purge_gap_hours": 168,
  "sequence_length": 168,
  "batch_size": 64,
  "shuffle_training_batches": true,
  "append_missing_indicators": true,
  "optimizer": {
    "enabled": true,
    "study_name": "cnn_bilstm_selected_v3_solar_v2",
    "storage_path": "artifacts/optimization/solar_models.db",
    "objective_metric": "validation_mae",
    "max_trials": 20,
    "timeout_seconds": 14400,
    "startup_trials": 5,
    "pruner_startup_trials": 5,
    "pruner_warmup_steps": 3,
    "heartbeat_interval_seconds": 60,
    "grace_period_seconds": 180,
    "max_failed_trial_retries": 1,
    "trial_epochs": 20,
    "early_stopping_patience": 5,
    "tuning_train_max_sequences": 250000,
    "tuning_validation_max_sequences": 100000
  },
  "early_stopping_patience": 5,
  "n_trials": 10,
  "epochs": 50,
  "use_optuna": true,
  "checkpoint": {
    "enabled": true,
    "resume": true,
    "root": "artifacts/checkpoints",
    "cnn_every_epochs": 1,
    "xgboost_every_rounds": 50
  }
}
