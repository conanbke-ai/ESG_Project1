{
  "model": "xgboost",
  "profile": "optimized",
  "seed": 42,
  "input_dataset": "file/standardized/model_ready.csv",
  "target_column": "generation_mwh",
  "energy_source_filter": "solar",
  "feature_columns": [
    "temperature_c",
    "precipitation_mm",
    "sunshine_hours",
    "solar_irradiance_mj_m2",
    "wind_speed_mps",
    "humidity_pct",
    "total_cloud_cover_tenths",
    "low_mid_cloud_cover_tenths",
    "hour",
    "dayofweek",
    "month",
    "hour_sin",
    "hour_cos",
    "dayofyear_sin",
    "dayofyear_cos",
    "generation_lag_24h_mwh",
    "generation_lag_168h_mwh",
    "generation_rolling_7d_mean_mwh",
    "capacity_mw",
    "tilt_deg",
    "station_latitude",
    "station_longitude",
    "station_elevation_m",
    "solar_elevation_sin",
    "clear_sky_irradiance_proxy",
    "is_daylight"
  ],
  "output_root": "artifacts/models/xgboost",
  "prediction_root": "artifacts/predictions/xgboost",
  "forecast_horizon_hours": 24,
  "feature_contract": "selected_v3_physics_aware_day_ahead",
  "quality_filter_column": "quality_train_eligible",
  "validation_fraction": 0.15,
  "calibration_fraction": 0.10,
  "test_fraction": 0.15,
  "purge_gap_hours": 168,
  "evaluation_protocol": "rolling_origin_day_ahead_with_observation_updates",
  "missing_value_policy": "xgboost_native_nan_learned_default_direction",
  "early_stopping_rounds": 10,
  "n_estimators": 500,
  "max_depth": 8,
  "learning_rate": 0.05,
  "subsample": 0.9,
  "colsample_bytree": 0.9,
  "resume": true
}
