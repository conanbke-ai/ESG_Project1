# Copy this file to .env.local and fill only the integrations you use.
# Never commit .env.local or real service keys.
DATA_GO_SERVICE_KEY=
KMA_CHROME_USER_DATA_DIR=

# Operational anomaly notifications are fail-safe off. Real delivery requires
# ENABLED=true, DRY_RUN=false, and the explicit CLI --live flag together.
SOLAR_NOTIFY_ENABLED=false
SOLAR_NOTIFY_DRY_RUN=true
SOLAR_NOTIFY_OUTBOX_PATH=artifacts/notifications/outbox.sqlite3
SOLAR_NOTIFY_MAX_ATTEMPTS_PER_CHANNEL=3
SOLAR_NOTIFY_RETRY_BASE_SECONDS=60
SOLAR_NOTIFY_RETRY_MAX_SECONDS=3600
SOLAR_NOTIFY_LEASE_SECONDS=120
SOLAR_NOTIFY_BATCH_SIZE=50

# SOLAPI values are read only during an explicitly enabled live dispatch.
SOLAR_NOTIFY_SOLAPI_API_KEY=
SOLAR_NOTIFY_SOLAPI_API_SECRET=
SOLAR_NOTIFY_SOLAPI_SENDER_NUMBER=
SOLAR_NOTIFY_SOLAPI_KAKAO_PF_ID=
SOLAR_NOTIFY_SOLAPI_KAKAO_TEMPLATE_ID=
SOLAR_NOTIFY_SOLAPI_ENDPOINT=https://api.solapi.com/messages/v4/send-many/detail
SOLAR_NOTIFY_SOLAPI_HTTP_TIMEOUT_SECONDS=10

# Example manager contact. Keep the real value only in .env.local or a secret manager.
SOLAR_MANAGER_EXAMPLE_PHONE=
